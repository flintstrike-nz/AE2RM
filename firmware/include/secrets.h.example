#pragma once

// Copy this file to secrets.h (gitignored) and fill in your network.
// Needed for OTA updates; the firmware also works fine offline if WiFi
// never connects -- it just skips OTA and keeps running the game.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Optional: set a password to require for OTA uploads (recommended once
// you're not on a trusted network). Leave empty ("") to require none.
#define OTA_PASSWORD  ""
