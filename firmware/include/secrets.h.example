#pragma once

// Copy this file to secrets.h (gitignored) and fill in your network.
// Needed for OTA updates; the firmware also works fine offline if WiFi
// never connects -- it just skips OTA and keeps running the game.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Recommended: set a password to require for OTA uploads. Leave empty
// ("") to allow unauthenticated OTA -- anyone who can reach the device
// on your network can then flash it; the firmware logs a warning at
// boot if you leave it empty, but still allows it (this is a hobby
// device, not something meant to sit on an untrusted network).
#define OTA_PASSWORD  ""
